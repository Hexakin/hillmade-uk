# Server-only settings. Copy to .env.local; never prefix secrets with NEXT_PUBLIC_.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
# Set true ONLY after enabling Double opt-in for API and integrations in MailerLite.
MAILERLITE_DOUBLE_OPT_IN_CONFIRMED=false

# Optional LOCAL DEV ONLY; ignored in production. Never sends or stores emails.
# NEWSLETTER_TEST_MODE=local
# CONTENT_DIR=.qa/content
